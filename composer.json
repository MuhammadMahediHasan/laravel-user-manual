{
    "name": "muhammadmahedihasan/laravel-user-manual",
    "description": "Markdown-based in-app user manual for Laravel applications",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "documentation",
        "user-manual",
        "markdown"
    ],
    "authors": [
        {
            "name": "Muhammad Mahedi Hasan",
            "homepage": "https://github.com/muhammadmahedihasan"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "league/commonmark": "^2.0",
        "mpdf/mpdf": "^8.2",
        "ext-intl": "*"
    },
    "require-dev": {
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/cache": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "larastan/larastan": "^2.9|^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^8.22|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.36|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.4|^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "MuhammadMahediHasan\\UserManual\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MuhammadMahediHasan\\UserManual\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MuhammadMahediHasan\\UserManual\\UserManualServiceProvider"
            ],
            "aliases": {
                "UserManual": "MuhammadMahediHasan\\UserManual\\Facades\\UserManual"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "pest -c phpunit.xml.dist",
        "pint": "pint",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
